#!/usr/bin/env node
// Checks the behaviours in design/behaviours/ and examples/behaviours/ against system/VOCABULARY.md
// and the notation.
// Usage: node system/bin/check                      every behaviour
//        node system/bin/check <file or folder> …   only those
// Exits with 1 when there is an error. Uses the same code as the page (system/voiceit.js).
'use strict';
const fs = require('fs');
const path = require('path');
const VoiceIt = require('../voiceit.js');

const root = path.resolve(__dirname, '..', '..');
const rel = p => path.relative(root, p).split(path.sep).join('/');

function readTree(dir, out = []){
  if (!fs.existsSync(dir)) return out;
  for (const e of fs.readdirSync(dir, {withFileTypes:true})) {
    if (e.name.startsWith('.') || e.name === 'node_modules') continue;
    const full = path.join(dir, e.name);
    if (e.isDirectory()) readTree(full, out);
    else if (/\.md$/i.test(e.name)) out.push({path:rel(full), text:fs.readFileSync(full, 'utf8')});
    else if (/\.(png|jpe?g|webp|svg)$/i.test(e.name)) out.push({path:rel(full), url:rel(full)});
  }
  return out;
}

const vocabPath = path.join(root, 'system', 'VOCABULARY.md');
if (!fs.existsSync(vocabPath)) { console.error('Cannot find system/VOCABULARY.md. Run this from the voiceit folder.'); process.exit(2); }
const vocab = VoiceIt.parseVocabulary(fs.readFileSync(vocabPath, 'utf8'));
if (vocab.problems.length) {
  vocab.problems.forEach(p => console.log(`system/VOCABULARY.md:${p.ln}  error    ${p.msg}`));
  console.log('The vocabulary itself has problems; fix those first.');
  process.exit(2);
}

const design = VoiceIt.buildDesign([...readTree(path.join(root, 'design')), ...readTree(path.join(root, 'examples'))]);
const args = process.argv.slice(2);
const missing = args.filter(a => !fs.existsSync(path.resolve(process.cwd(), a)));
if (missing.length) { missing.forEach(a => console.log(`${a}  error    No such file or folder.`)); process.exit(1); }
const targets = args.map(a => rel(path.resolve(process.cwd(), a)).replace(/\/$/, ''));
const wanted = file => !targets.length || targets.some(t => t === '' || file === t || file.startsWith(t + '/'));

const problems = []; let checked = 0;
for (const b of Object.values(design.behaviours)) {
  if (!wanted(b.path)) continue;
  checked++;
  const r = VoiceIt.validateBehaviour(b.text, vocab);
  r.errors.forEach(p => problems.push({file:b.path, ln:p.ln, level:'error', msg:p.msg}));
  r.warnings.forEach(p => problems.push({file:b.path, ln:p.ln, level:'warning', msg:p.msg}));
  if (!r.errors.length) {
    const sched = VoiceIt.schedule(r.parsed.lines, VoiceIt.cast(r.parsed.lines, b.meta.voice, vocab, VoiceIt.parsePeople(b.meta.people)), vocab);
    console.log(`${b.path}  plays for about ${VoiceIt.formatTime(sched.total)} (${r.parsed.lines.length} lines)`);
  }
}
if (!targets.length && !Object.values(design.forms).some(f => !f.example)) problems.push({file:'design/forms/', ln:0, level:'warning', msg:'No forms of your own yet: save an image of your product in design/forms/.'});

problems.sort((a, b) => a.file.localeCompare(b.file) || a.ln - b.ln);
problems.forEach(p => console.log(`${p.file}${p.ln ? ':' + p.ln : ''}  ${p.level.padEnd(7)}  ${p.msg}`));
const errors = problems.filter(p => p.level === 'error').length, warnings = problems.length - errors;
const n = (k, w) => `${k} ${w}${k === 1 ? '' : 's'}`;
console.log(`\nChecked ${n(checked, 'behaviour')}: ${n(errors, 'error')}, ${n(warnings, 'warning')}.`);
if (!checked) console.log('No behaviours found there. Behaviours live in design/behaviours/.');
process.exit(errors ? 1 : 0);
